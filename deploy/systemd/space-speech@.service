[Unit]
# Wake word, transcription and the Personal Context call
#
# Entirely optional. A missing microphone or model must never stop the
# regulatory loop, so this unit is wanted by the target rather than
# required by it.
Description=Wake word, transcription and the Personal Context call
After=network-online.target docker.service
Wants=network-online.target
# The broker is the only hard dependency: nothing can publish without it.
# It is a container rather than a unit, so this is a start order rather than
# a requirement -- a component that comes up first reconnects when it lands.
PartOf=space.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/edge-smart-space
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/edge-smart-space/.venv/bin/python -m src.speech --config config/default.yaml
# Restart independence is a requirement rather than a convenience (section
# 9.3): killing any one process and watching the rest carry on is part of the
# demonstration, so every unit restarts itself and none takes another down.
Restart=always
RestartSec=5
# A component that cannot start at all should be visible rather than spinning.
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=space.target
