# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/

# Environments
.venv/
venv/
.env

# Testing, typing, linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Recorded runs and experiment artefacts (FR-62)
data/
runs/
*.parquet
*.csv
*.log

# A node's own configuration layers (deploy/provision.sh). The repository
# carries config/default.yaml; what one room decided stays on that room.
config/site.yaml
config/calibration.yaml

# Persisted estimator state (FR-07)
state/
*.npz

# Model weights — multi-GB, never in git
models/
*.gguf

# Local Claude Code settings.
# The rest of .claude/ IS tracked: skills are shared with the team.
.claude/settings.local.json

# OS and editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Exported documents. The Markdown in docs/ is the source; a PDF of it is a
# build artefact that goes stale silently and diffs as noise.
docs/*.pdf

# Console frontend build tooling; the built bundle in src/console/static is committed
node_modules/
*.tsbuildinfo
